{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "UTC",
  "schedule": ["at any time"],
  "baseBranches": ["main", "dev"],
  "enabledManagers": ["gomod", "github-actions", "dockerfile", "pip-compile", "custom.regex"],
  "pip-compile": {
    "managerFilePatterns": ["/^docs\\/requirements\\.lock$/"]
  },
  "commitMessagePrefix": "chore(deps):",
  "dependencyDashboard": false,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "packageRules": [
    {
      "matchUpdateTypes": ["major", "minor", "patch", "pin", "digest"],
      "groupName": "all dependencies"
    },
    {
      "description": "Indirect Go deps float with their parents. Renovate's default (indirect updates disabled) avoids standalone bumps across module renames / replace directives. Real CVEs in indirect deps are still raised via osvVulnerabilityAlerts.",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "enabled": false
    },
    {
      "description": "Only vulnerability alerts update main; routine dependency updates are integrated and tested on dev first (see docs/development/branching.md)",
      "matchBaseBranches": ["main"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/[^/]+\\.ya?ml$", "^Makefile$", "^hack/[^/]+\\.sh$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\s+\\S+?\\s*(?:\\?=|[:=])\\s*[\"']?(?<currentValue>[^\"'\\s]+)"
      ]
    }
  ]
}
